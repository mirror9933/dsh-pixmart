{
  "name": "dsh-pixmart",
  "version": "0.1.1",
  "description": "DSH 电商生图插件：主图 / 详情图 / 广告图生成，风格复刻，作品库与生图实时预览",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node tools/strip-test-hooks.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node tools/strip-test-hooks.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm test:browser",
    "prepare": "tsc -p tsconfig.json && node tools/strip-test-hooks.mjs",
    "prepack": "tsc -p tsconfig.json && node tools/strip-test-hooks.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
